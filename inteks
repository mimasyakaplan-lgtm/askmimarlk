const META={'':'Mersin merkezli mimari tasarım, iç mimarlık, 3D render ve anahtar teslim uygulama.',hakkimizda:'ASK Mimarlık tasarım felsefesi: iklim verisi, malzeme entegrasyonu, ışık ve gölge.',hizmetlerimiz:'Mimari tasarım, iç mimari, 3D görselleştirme, anahtar teslim uygulama ve özel mobilya.',projeler:'Konut, ofis, cafe, restoran ve mağaza projelerimizden bir seçki.',iletisim:'ASK Mimarlık ile iletişime geçin ve proje teklifi alın.'};
let current='';
function setMeta(t,d){document.title=t;const m=document.querySelector('meta[name="description"]');if(m)m.setAttribute('content',d)}
function route(){
  const h=location.hash.replace(/^#\/?/,'');const [a,b]=h.split('/');
  let key=a||'',html;
  if(key==='proje'){html=project(b);const p=PROJECTS.find(x=>x.slug===b);setMeta(p?`${p.title} | ASK Mimarlık`:'Proje | ASK Mimarlık',p?p.story.slice(0,150):'');key='projeler'}
  else if(key==='hakkimizda')html=about();
  else if(key==='hizmetlerimiz')html=services();
  else if(key==='projeler')html=projects();
  else if(key==='iletisim')html=contact();
  else{key='';html=home()}
  if(a!=='proje')setMeta(TITLES[key],META[key]);
  current=key;
  app.classList.remove('enter');void app.offsetWidth;app.innerHTML=html;app.classList.add('enter');
  window.scrollTo(0,0);
  $$('.nav a').forEach(l=>l.removeAttribute('aria-current'));
  const act=document.querySelector(`.nav a[data-r="${key}"]`);if(act)act.setAttribute('aria-current','page');
  closeNav();updateHeader();initCounters();
}
function $$(s,r){return [...(r||document).querySelectorAll(s)]}
function updateHeader(){hdr.classList.toggle('on-dark',current===''&&window.scrollY<window.innerHeight*.8)}
let tick=false;window.addEventListener('scroll',()=>{if(!tick){tick=true;requestAnimationFrame(()=>{updateHeader();tick=false})}},{passive:true});
window.addEventListener('hashchange',route);

/* Sayaç animasyonu */
function initCounters(){
  const els=$$('[data-count]');if(!els.length)return;
  const run=el=>{const to=+el.dataset.count,suf=el.dataset.suffix||'',t0=performance.now(),d=1600;
    (function step(t){const k=Math.min(1,(t-t0)/d),e=1-Math.pow(1-k,3);el.textContent=Math.round(to*e).toLocaleString('tr-TR')+(k===1?suf:'');if(k<1)requestAnimationFrame(step)})(t0)};
  const reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduce||!('IntersectionObserver' in window)){els.forEach(el=>el.textContent=(+el.dataset.count).toLocaleString('tr-TR')+(el.dataset.suffix||''));return}
  const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){run(e.target);io.unobserve(e.target)}}),{threshold:.6});
  els.forEach(el=>io.observe(el));
}

/* Menü */
const nav=document.getElementById('nav'),menu=document.getElementById('menu');
function closeNav(){nav.classList.remove('open');menu.setAttribute('aria-expanded','false');menu.setAttribute('aria-label','Menüyü aç')}
menu.addEventListener('click',()=>{const o=nav.classList.toggle('open');menu.setAttribute('aria-expanded',o);menu.setAttribute('aria-label',o?'Menüyü kapat':'Menüyü aç')});

/* Tema */
const root=document.documentElement;
try{const t=localStorage.getItem('ask-theme');if(t)root.setAttribute('data-theme',t)}catch(e){}
document.getElementById('theme').addEventListener('click',()=>{
  const cur=root.getAttribute('data-theme')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');
  const nx=cur==='dark'?'light':'dark';root.setAttribute('data-theme',nx);
  try{localStorage.setItem('ask-theme',nx)}catch(e){}
});

/* Filtre ve olaylar */
document.addEventListener('click',e=>{
  const f=e.target.closest('[data-filter]');
  if(f){const box=f.closest('.portfolio'),k=f.dataset.filter,lim=+box.dataset.limit||99;
    $$('.chip',box).forEach(c=>c.setAttribute('aria-pressed',c===f));
    const grid=box.querySelector('.pgrid');grid.classList.add('fading');
    setTimeout(()=>{const list=PROJECTS.filter(p=>k==='all'||p.cat===k).slice(0,lim);grid.innerHTML=list.length?list.map(card).join(''):'<p class="empty">Bu kategoride henüz proje yok.</p>';grid.classList.remove('fading')},230);
    return}
  if(e.target.closest('[data-scroll]')){const n=document.querySelector('.hero').nextElementSibling;if(n)n.scrollIntoView({behavior:'smooth'});return}
  const lbBtn=e.target.closest('[data-lb]');
  if(lbBtn){openLb(lbBtn.dataset.lb,+lbBtn.dataset.i,lbBtn);return}
  const mail=e.target.closest('[data-mail]');
  if(mail){const f2=mail.closest('form');if(validate(f2)){const d=data(f2);location.href=`mailto:${CFG.email}?subject=${encodeURIComponent('Proje teklifi: '+d.tip)}&body=${encodeURIComponent(msg(d))}`;status(f2,'E-posta uygulamanız açıldı. Mesajı göndererek talebinizi tamamlayın.')}}
});

/* Lightbox */
const lb=document.getElementById('lb'),stage=document.getElementById('lbstage'),cap=document.getElementById('lbcap');
let lbP=null,lbI=0,lbFrom=null;
function showLb(){stage.classList.remove('zoom');stage.innerHTML=media(lbP,lbI);cap.textContent=`${lbP.title}  ${lbI+1} / 4`;const s=stage.querySelector('svg,img');if(s)s.style.transformOrigin='50% 50%'}
function openLb(slug,i,from){lbP=PROJECTS.find(p=>p.slug===slug);if(!lbP)return;lbI=i||0;lbFrom=from;lb.hidden=false;document.body.style.overflow='hidden';showLb();lb.querySelector('.lb-x').focus()}
function closeLb(){lb.hidden=true;document.body.style.overflow='';if(lbFrom)lbFrom.focus()}
function stepLb(d){lbI=(lbI+d+4)%4;showLb()}
lb.querySelector('.lb-x').addEventListener('click',closeLb);
lb.querySelector('.prev').addEventListener('click',()=>stepLb(-1));
lb.querySelector('.next').addEventListener('click',()=>stepLb(1));
stage.addEventListener('click',e=>{const z=stage.classList.toggle('zoom');const s=stage.querySelector('svg,img');if(s){const r=stage.getBoundingClientRect();s.style.transformOrigin=`${((e.clientX-r.left)/r.width*100).toFixed(1)}% ${((e.clientY-r.top)/r.height*100).toFixed(1)}%`}});
stage.addEventListener('mousemove',e=>{if(!stage.classList.contains('zoom'))return;const s=stage.querySelector('svg,img'),r=stage.getBoundingClientRect();if(s)s.style.transformOrigin=`${((e.clientX-r.left)/r.width*100).toFixed(1)}% ${((e.clientY-r.top)/r.height*100).toFixed(1)}%`});
lb.addEventListener('click',e=>{if(e.target===lb)closeLb()});
document.addEventListener('keydown',e=>{if(lb.hidden)return;if(e.key==='Escape')closeLb();if(e.key==='ArrowRight')stepLb(1);if(e.key==='ArrowLeft')stepLb(-1);
  if(e.key==='Tab'){const f=$$('button',lb);const a=document.activeElement,i=f.indexOf(a);if(e.shiftKey&&i<=0){e.preventDefault();f[f.length-1].focus()}else if(!e.shiftKey&&i===f.length-1){e.preventDefault();f[0].focus()}}});

/* Teklif formu */
function data(f){const d=Object.fromEntries(new FormData(f).entries());return d}
function msg(d){return `Merhaba, ASK Mimarlık için proje teklifi talep ediyorum.\n\nAd Soyad: ${d.ad}\nE-posta: ${d.mail}\nProje tipi: ${d.tip}\nTahmini alan: ${d.m2?d.m2+' m²':'-'}\n\n${d.msg}`}
function status(f,t){f.querySelector('.status').textContent=t}
function validate(f){
  let ok=true;
  [['ad','Adınızı ve soyadınızı yazın.'],['mail','Geçerli bir e-posta adresi yazın.'],['msg','Projenizi kısaca anlatın.']].forEach(([n,m])=>{
    const el=f.elements[n],err=el.parentElement.querySelector('.err'),bad=!el.value.trim()||(n==='mail'&&!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(el.value));
    err.textContent=bad?m:'';el.setAttribute('aria-invalid',bad);if(bad&&ok){el.focus()}if(bad)ok=false});
  return ok}
document.addEventListener('submit',e=>{
  const f=e.target.closest('form.quote');if(!f)return;e.preventDefault();
  if(!validate(f)){status(f,'');return}
  const d=data(f);window.open(`https://wa.me/${CFG.wa}?text=${encodeURIComponent(msg(d))}`,'_blank','noopener');
  status(f,'WhatsApp açıldı. Mesajı göndererek talebinizi tamamlayın.');
});

/* Footer iletişim */
document.getElementById('wafloat').href=`https://wa.me/${CFG.wa}?text=${encodeURIComponent('Merhaba, ASK Mimarlık hakkında bilgi almak istiyorum.')}`;
document.getElementById('fcontact').innerHTML=`<li>${CFG.addr}</li><li><a href="mailto:${CFG.email}">${CFG.email}</a></li><li><a href="tel:${CFG.phone.replace(/[^+\d]/g,'')}">${CFG.phone}</a></li><li><a href="https://wa.me/${CFG.wa}" target="_blank" rel="noopener">WhatsApp</a></li>`;

route();
})();
