<style>
/* ---------- Tokenlar: yalnızca verilen RGB paleti ----------
   59,47,36 = #3B2F24 | 183,173,155 = #B7AD9B | 232,226,217 = #E8E2D9
   138,122,104 = #8A7A68 | 215,206,193 = #D7CEC1 | 193,183,167 = #C1B7A7  */
:root{
  --espresso:#3B2F24; --sand:#B7AD9B; --paper:#E8E2D9; --umber:#8A7A68; --travertine:#D7CEC1; --stone:#C1B7A7; --sage:#7B8466;
  --bg:#E8E2D9; --bg-2:#D7CEC1; --card:#EFEAE2; --ink:#3B2F24; --ink-2:#5C4D3E; --line:rgba(59,47,36,.24);
  --map:grayscale(.45) sepia(.25) contrast(.95);
  box-sizing:border-box; padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
  --serif:'Cormorant Garamond','Cormorant',Georgia,'Times New Roman',serif;
  --sans:'Plus Jakarta Sans',system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;
  --hdr:72px;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){--bg:#3B2F24;--bg-2:#33281F;--card:#44372B;--ink:#E8E2D9;--ink-2:#C1B7A7;--line:rgba(232,226,217,.24);--map:invert(.92) hue-rotate(180deg) grayscale(.55) sepia(.2) contrast(.9)}
}
:root[data-theme="dark"]{--bg:#3B2F24;--bg-2:#33281F;--card:#44372B;--ink:#E8E2D9;--ink-2:#C1B7A7;--line:rgba(232,226,217,.24);--map:invert(.92) hue-rotate(180deg) grayscale(.55) sepia(.2) contrast(.9)}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:calc(var(--hdr) + env(safe-area-inset-top,0px));height:100%;-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:1rem;line-height:1.7;transition:background .4s,color .4s;-webkit-font-smoothing:antialiased}
img,svg{max-width:100%}
a{color:inherit;text-decoration:none}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:2px solid currentColor;outline-offset:3px}
.skip{position:absolute;left:-999px;top:0;background:var(--ink);color:var(--bg);padding:.6rem 1rem;z-index:100}
.skip:focus{left:0}
h1,h2,h3,h4{font-family:var(--serif);font-weight:500;line-height:1.06;letter-spacing:-.012em;margin:0}
h2{font-size:clamp(2.1rem,4.4vw,3.7rem)}
h3{font-size:1.65rem;line-height:1.15}
p{margin:0 0 1em}
.wrap{width:min(92%,1280px);margin:0 auto}
.sec{padding:clamp(4.5rem,9vw,8.5rem) 0}
.sec.alt{background:var(--bg-2)}
.lead{font-size:1.12rem;color:var(--ink-2);max-width:56ch}
.muted{color:var(--ink-2)}

/* ---------- Header ---------- */
#hdr{position:fixed;top:0;left:0;right:0;z-index:50;padding-top:env(safe-area-inset-top,0px);
  background:color-mix(in srgb,var(--bg) 72%,transparent);-webkit-backdrop-filter:blur(18px) saturate(1.15);backdrop-filter:blur(18px) saturate(1.15);
  border-bottom:1px solid var(--line);transition:background .4s,color .4s,border-color .4s}
#hdr.on-dark{background:rgba(59,47,36,.42);color:#E8E2D9;border-color:rgba(232,226,217,.2)}
.hbar{height:var(--hdr);display:flex;align-items:center;justify-content:space-between;gap:1rem}
.logo{display:flex;align-items:center;gap:.8rem}
.logo svg{width:30px;height:34px;flex:none}
.logo b{display:block;font-family:var(--serif);font-weight:600;font-size:1.32rem;letter-spacing:.2em;line-height:1}
.logo small{display:block;font-size:.66rem;letter-spacing:.12em;opacity:.78;margin-top:.3rem;font-weight:500}
.nav{display:flex;align-items:center;gap:2.1rem}
.nav a{position:relative;font-size:.92rem;font-weight:500;padding:.4rem 0}
.nav a::after{content:"";position:absolute;left:0;right:100%;bottom:0;height:1px;background:currentColor;transition:right .35s ease}
.nav a:hover::after,.nav a[aria-current="page"]::after{right:0}
.hbtns{display:flex;align-items:center;gap:.4rem}
.icon-btn{width:40px;height:40px;display:grid;place-items:center;background:none;border:0;cursor:pointer;border-radius:50%}
.icon-btn:hover{background:color-mix(in srgb,currentColor 12%,transparent)}
.menu-btn{display:none}
@media (max-width:900px){
  .menu-btn{display:grid}
  .nav{position:fixed;inset:calc(var(--hdr) + env(safe-area-inset-top,0px)) 0 0 0;background:var(--bg);color:var(--ink);flex-direction:column;align-items:flex-start;justify-content:flex-start;gap:0;padding:1.5rem 6%;transform:translateY(-8px);opacity:0;visibility:hidden;transition:.3s}
  .nav.open{opacity:1;visibility:visible;transform:none}
  .nav a{font-family:var(--serif);font-size:2rem;padding:.9rem 0;width:100%;border-bottom:1px solid var(--line)}
  .nav a::after{display:none}
}


/* ---------- Logo (tek renkli maske: temaya göre renk değiştirir) ---------- */
:root{--logo-sym:url("data:image/png;base64,");--logo-full:url("data:image/png;base64,")}
.lmark{display:block;height:44px;aspect-ratio:520/419;flex:none;background:currentColor;-webkit-mask:var(--logo-sym) center/contain no-repeat;mask:var(--logo-sym) center/contain no-repeat}
.lfull{display:block;height:130px;aspect-ratio:700/766;margin-bottom:1.4rem;background:currentColor;-webkit-mask:var(--logo-full) center/contain no-repeat;mask:var(--logo-full) center/contain no-repeat}

/* ---------- Butonlar ---------- */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.6rem;padding:.95rem 1.7rem;border:1px solid var(--ink);background:var(--ink);color:var(--bg);font-weight:500;font-size:.95rem;cursor:pointer;transition:background .3s,color .3s,border-color .3s;border-radius:2px}
.btn:hover{background:transparent;color:var(--ink)}
.btn.ghost{background:transparent;color:var(--ink)}
.btn.ghost:hover{background:var(--ink);color:var(--bg)}
.btn.wa{background:#3B2F24;border-color:#3B2F24;color:#E8E2D9}
.btn.wa:hover{background:#8A7A68;border-color:#8A7A68;color:#fff}
.link{display:inline-flex;gap:.5rem;font-weight:500;border-bottom:1px solid currentColor;padding-bottom:.15rem}
.link:hover{opacity:.7}

/* ---------- Hero ---------- */
.hero{position:relative;min-height:100svh;background:#3B2F24;color:#E8E2D9;overflow:hidden;display:flex;align-items:flex-end}
.hero-art{position:absolute;top:0;right:0;bottom:0;width:min(62%,900px);animation:fade 1.8s ease both}
.hero-art svg{width:100%;height:100%;display:block}
.hero::before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,#3B2F24 0%,#3B2F24 34%,rgba(59,47,36,.55) 58%,rgba(59,47,36,0) 82%)}
.hero::after{content:"";position:absolute;left:0;right:0;bottom:0;height:34%;z-index:1;background:linear-gradient(0deg,rgba(59,47,36,.7),transparent)}
.hero-copy{position:relative;z-index:2;width:min(92%,1280px);margin:0 auto;padding:calc(var(--hdr) + 3rem) 0 clamp(5.5rem,13vh,8.5rem)}
.hero h1{font-size:clamp(2.45rem,5.3vw,4.7rem);max-width:11em;font-weight:500;animation:rise 1.2s .15s cubic-bezier(.2,.7,.2,1) both}
.hero p{max-width:46ch;margin:1.6rem 0 2.2rem;color:#D7CEC1;font-size:1.08rem;animation:rise 1.2s .35s cubic-bezier(.2,.7,.2,1) both}
.hero .cta{display:flex;flex-wrap:wrap;gap:.9rem;animation:rise 1.2s .5s cubic-bezier(.2,.7,.2,1) both}
.hero .btn{background:#E8E2D9;border-color:#E8E2D9;color:#3B2F24}
.hero .btn:hover{background:transparent;color:#E8E2D9}
.hero .btn.ghost{background:transparent;color:#E8E2D9;border-color:rgba(232,226,217,.6)}
.hero .btn.ghost:hover{background:#E8E2D9;color:#3B2F24}
.shade{animation:slide 44s linear infinite}
@keyframes slide{to{transform:translateX(132px)}}
@keyframes rise{from{opacity:0;transform:translateY(26px)}to{opacity:1;transform:none}}
@keyframes fade{from{opacity:0}to{opacity:1}}
.scroll{background:none;border:0;padding:0;cursor:pointer;font-family:inherit;position:absolute;z-index:2;left:50%;bottom:1.4rem;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:.5rem;font-size:.72rem;letter-spacing:.14em;color:#C1B7A7}
.scroll i{display:block;width:1px;height:46px;background:rgba(232,226,217,.3);position:relative;overflow:hidden}
.scroll i::after{content:"";position:absolute;left:0;top:-14px;width:1px;height:14px;background:#E8E2D9;animation:drip 2.2s ease-in-out infinite}
@keyframes drip{to{top:46px}}
@media (max-width:760px){
  .hero-art{width:100%;opacity:.62}
  .hero::before{background:linear-gradient(0deg,#3B2F24 8%,rgba(59,47,36,.7) 55%,rgba(59,47,36,.2))}
  .scroll{display:none}
}

/* ---------- Künye (metrikler) ---------- */
.tb{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--ink);margin:0}
.tb>div{padding:1.6rem 1.8rem 2rem;border-right:1px solid var(--ink)}
.tb>div:last-child{border-right:0}
.tb dt{font-size:.88rem;color:var(--ink-2);padding-bottom:.8rem;margin-bottom:1.3rem;border-bottom:1px solid var(--line)}
.tb dd{margin:0;font-family:var(--serif);font-size:clamp(3rem,6vw,5rem);line-height:1;font-weight:500}
.tb dd span{font-size:.45em;margin-left:.15em;color:var(--ink-2)}
@media (max-width:760px){.tb{grid-template-columns:1fr}.tb>div{border-right:0;border-bottom:1px solid var(--ink)}.tb>div:last-child{border-bottom:0}}

/* ---------- Bölüm başlıkları ---------- */
.shead{display:grid;grid-template-columns:1.1fr .9fr;gap:3rem;align-items:end;margin-bottom:clamp(2.2rem,4vw,3.6rem)}
.shead p{margin:0;color:var(--ink-2)}
@media (max-width:860px){.shead{grid-template-columns:1fr;gap:1rem}}

/* ---------- Hakkımızda özeti ---------- */
.about-sum{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(2rem,6vw,6rem);align-items:center}
.arch{aspect-ratio:3/4;border-radius:999px 999px 0 0;overflow:hidden;background:var(--sand)}
.arch svg,.ph svg{width:100%;height:100%;display:block}
.about-sum h2{margin-bottom:1.6rem}
.about-sum .vision{border-left:1px solid var(--ink);padding-left:1.3rem;margin:1.6rem 0 2rem;font-family:var(--serif);font-size:1.45rem;line-height:1.35}
@media (max-width:860px){.about-sum{grid-template-columns:1fr}.arch{max-width:420px}}

/* ---------- Hizmet kartları ---------- */
.svc-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--ink)}
.svc{padding:2rem 1.6rem 2.4rem;border-right:1px solid var(--line);transition:background .35s,color .35s;display:flex;flex-direction:column;gap:1rem;min-height:21rem}
.svc:last-child{border-right:0}
.svc svg{width:44px;height:44px;stroke:currentColor;fill:none;stroke-width:1.2}
.svc p{color:var(--ink-2);margin:0;font-size:.97rem}
.svc:hover{background:var(--ink);color:var(--bg)}
.svc:hover p{color:var(--stone)}
.svc .more{margin-top:auto;font-size:.9rem;font-weight:500}
@media (max-width:1000px){.svc-grid{grid-template-columns:repeat(2,1fr)}.svc{border-bottom:1px solid var(--line)}.svc:nth-child(2){border-right:0}}
@media (max-width:560px){.svc-grid{grid-template-columns:1fr}.svc{border-right:0;min-height:0}}

/* ---------- Portfolyo ---------- */
.filters{display:flex;flex-wrap:wrap;gap:.6rem;margin-bottom:2.2rem}
.chip{background:transparent;border:1px solid var(--line);padding:.55rem 1.1rem;border-radius:999px;font-size:.9rem;cursor:pointer;transition:.3s}
.chip:hover{border-color:var(--ink)}
.chip[aria-pressed="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.pgrid{columns:3;column-gap:1.4rem;transition:opacity .25s}
.pgrid.fading{opacity:0}
.pcard{display:block;break-inside:avoid;margin-bottom:1.4rem}
.pcard figure{margin:0;position:relative;overflow:hidden;background:var(--sand);aspect-ratio:4/5}
.pcard:nth-child(3n+2) figure{aspect-ratio:1/1}
.pcard:nth-child(3n) figure{aspect-ratio:4/4.6}
.pcard:nth-child(4n+1) figure{aspect-ratio:4/5.1}
.pcard svg{width:100%;height:100%;display:block;transition:transform 1s cubic-bezier(.2,.7,.2,1)}
.pcard:hover svg{transform:scale(1.05)}
.pcard figcaption{position:absolute;left:0;right:0;bottom:0;padding:3rem 1.3rem 1.2rem;color:#E8E2D9;background:linear-gradient(0deg,rgba(59,47,36,.9),rgba(59,47,36,0))}
.pcard figcaption small{font-size:.8rem;color:#D7CEC1}
.pcard figcaption h3{margin:.15rem 0 0}
.pc-meta{display:flex;justify-content:space-between;gap:1rem;font-size:.85rem;color:#D7CEC1;max-height:0;opacity:0;overflow:hidden;transition:max-height .45s ease,opacity .45s ease,margin .45s}
.pcard:hover .pc-meta,.pcard:focus-visible .pc-meta{max-height:3rem;opacity:1;margin-top:.5rem}
@media (hover:none){.pc-meta{max-height:3rem;opacity:1;margin-top:.5rem}}
@media (max-width:980px){.pgrid{columns:2}}
@media (max-width:560px){.pgrid{columns:1}}
.empty{padding:3rem 0;color:var(--ink-2)}

/* ---------- Çözüm ortakları bandı ---------- */
.band{overflow:hidden;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:2.2rem 0}
.track{display:flex;width:max-content;gap:4.5rem;animation:marq 48s linear infinite}
.band:hover .track{animation-play-state:paused}
.track span{font-family:var(--serif);font-style:italic;font-size:1.9rem;color:var(--ink);opacity:.5;white-space:nowrap}
@keyframes marq{to{transform:translateX(calc(-50% - 2.25rem))}}

/* ---------- CTA bandı ---------- */
.cta-band{background:#3B2F24;color:#E8E2D9;position:relative;overflow:hidden}
.cta-band::before{content:"";position:absolute;inset:0 auto 0 0;width:min(22%,260px);background:repeating-linear-gradient(90deg,#8A7A68 0 12px,#3B2F24 12px 20px);opacity:.55}
.cta-band .wrap{position:relative;display:flex;justify-content:space-between;align-items:center;gap:2rem;flex-wrap:wrap;padding:clamp(3.5rem,7vw,6rem) 0 clamp(3.5rem,7vw,6rem) min(20%,240px)}
.cta-band h2{max-width:14em}
.cta-band .btn{background:#E8E2D9;color:#3B2F24;border-color:#E8E2D9}
.cta-band .btn:hover{background:transparent;color:#E8E2D9}
@media (max-width:700px){.cta-band::before{width:18px;opacity:.7}.cta-band .wrap{padding-left:2.2rem}}

/* ---------- İç sayfa başlığı ---------- */
.phead{padding:calc(var(--hdr) + clamp(3.5rem,8vw,7rem)) 0 clamp(2.5rem,5vw,4.5rem);border-bottom:1px solid var(--line)}
.phead h1{font-size:clamp(2.8rem,7vw,6rem);max-width:12em}
.phead p{margin-top:1.4rem}

/* ---------- Hakkımızda sayfası ---------- */
.story{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,6vw,6rem)}
.story p{color:var(--ink-2)}
.story .big{font-family:var(--serif);font-size:clamp(1.6rem,2.6vw,2.2rem);line-height:1.3;color:var(--ink)}
.approach{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--ink)}
.approach>div{padding:2.2rem 2rem 2.6rem 0;border-bottom:1px solid var(--line)}
.approach>div:nth-child(odd){border-right:1px solid var(--line)}
.approach>div:nth-child(even){padding-left:2rem}
.approach h3{margin-bottom:.8rem}
.approach p{color:var(--ink-2);margin:0}
.steps{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);counter-reset:s;border-top:1px solid var(--ink)}
.steps li{counter-increment:s;padding:1.6rem 1.4rem 2rem 0;position:relative}
.steps li::before{content:counter(s);font-family:var(--serif);font-size:2.6rem;color:var(--umber);display:block;margin-bottom:.8rem}
.steps li+li{padding-left:1.4rem;border-left:1px solid var(--line)}
.steps p{color:var(--ink-2);margin:.6rem 0 0;font-size:.96rem}
@media (max-width:900px){
  .story,.approach{grid-template-columns:1fr}
  .approach>div:nth-child(odd){border-right:0}.approach>div:nth-child(even){padding-left:0}
  .steps{grid-template-columns:1fr 1fr}.steps li:nth-child(3){border-left:0;padding-left:0}
}
@media (max-width:520px){.steps{grid-template-columns:1fr}.steps li+li{border-left:0;padding-left:0;border-top:1px solid var(--line)}}

/* ---------- Hizmetler sayfası ---------- */
.srow{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,6vw,6rem);align-items:center;padding:clamp(2.5rem,5vw,4.5rem) 0;border-bottom:1px solid var(--line)}
.srow:nth-child(even) .ph{order:2}
.srow .ph{aspect-ratio:4/3;overflow:hidden;background:var(--sand)}
.srow h2{font-size:clamp(1.9rem,3.4vw,2.9rem);margin-bottom:.4rem}
.srow .sub{color:var(--umber);font-style:italic;font-family:var(--serif);font-size:1.25rem;margin-bottom:1rem}
.srow ul{list-style:none;padding:0;margin:1.4rem 0 0}
.srow li{padding:.7rem 0;border-top:1px solid var(--line);color:var(--ink-2)}
@media (max-width:860px){.srow{grid-template-columns:1fr}.srow:nth-child(even) .ph{order:0}}

/* ---------- Proje detayı ---------- */
.pd-hero{height:min(78vh,760px);min-height:380px;position:relative;background:var(--sand);overflow:hidden;cursor:zoom-in;display:block;width:100%;border:0;padding:0}
.pd-hero svg{width:100%;height:100%;display:block}
.pd-title{padding:2.5rem 0 1.5rem}
.pd-title h1{font-size:clamp(2.5rem,6vw,5rem)}
.pd-title .back{display:inline-block;margin-bottom:1.4rem;font-size:.92rem}
.meta{display:grid;grid-template-columns:repeat(5,auto);gap:0;border:1px solid var(--ink);margin:1.6rem 0 0}
.meta>div{padding:1rem 1.3rem;border-right:1px solid var(--ink)}
.meta>div:last-child{border-right:0}
.meta dt{font-size:.8rem;color:var(--ink-2);margin-bottom:.2rem}
.meta dd{margin:0;font-weight:500}
@media (max-width:900px){.meta{grid-template-columns:1fr 1fr}.meta>div{border-bottom:1px solid var(--ink)}.meta>div:nth-child(2n){border-right:0}.meta>div:last-child{grid-column:1/-1;border-bottom:0}}
.gal{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem}
.gal button{display:block;border:0;padding:0;background:var(--sand);aspect-ratio:4/3;overflow:hidden;cursor:zoom-in}
.gal button:first-child{grid-column:span 2;aspect-ratio:auto}
.gal svg{width:100%;height:100%;display:block;transition:transform .9s cubic-bezier(.2,.7,.2,1)}
.gal button:hover svg{transform:scale(1.04)}
@media (max-width:700px){.gal{grid-template-columns:1fr}.gal button:first-child{grid-column:auto;aspect-ratio:4/3}}
.mats{list-style:none;padding:0;margin:1.5rem 0 0}
.mats li{display:flex;align-items:center;gap:1rem;padding:.8rem 0;border-top:1px solid var(--line)}
.mats i{width:30px;height:30px;flex:none;border:1px solid var(--line)}
.pnext{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;border-top:1px solid var(--ink);padding:2rem 0}
.pnext a{font-family:var(--serif);font-size:1.8rem}
.pnext a:hover{opacity:.65}

/* ---------- Lightbox ---------- */
.lb{position:fixed;inset:0;z-index:90;background:rgba(36,28,21,.96);color:#E8E2D9;display:flex;align-items:center;justify-content:center;padding:1rem}
.lb[hidden]{display:none}
.lb-stage{width:min(94vw,1180px);aspect-ratio:4/3;max-height:82vh;overflow:hidden;position:relative;cursor:zoom-in;background:#3B2F24}
.lb-stage.zoom{cursor:zoom-out}
.lb-stage svg{width:100%;height:100%;display:block;transition:transform .45s cubic-bezier(.2,.7,.2,1)}
.lb-stage.zoom svg{transform:scale(2.2)}
.lb button{background:none;border:0;color:inherit;cursor:pointer}
.lb-x{position:absolute;top:calc(.8rem + env(safe-area-inset-top,0px));right:1rem;font-size:2.2rem;width:48px;height:48px;line-height:1}
.lb-n{position:absolute;top:50%;transform:translateY(-50%);font-size:3rem;width:56px;height:80px}
.lb-n.prev{left:.4rem}.lb-n.next{right:.4rem}
.lb-cap{position:absolute;bottom:calc(1rem + env(safe-area-inset-bottom,0px));left:0;right:0;text-align:center;font-size:.9rem;color:#C1B7A7}

/* ---------- İletişim ---------- */
.contact{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(2rem,7vw,7rem)}
.cinfo{list-style:none;margin:2rem 0;padding:0}
.cinfo li{display:grid;grid-template-columns:7rem 1fr;gap:1rem;padding:1rem 0;border-top:1px solid var(--line)}
.cinfo li span:first-child{color:var(--ink-2);font-size:.9rem}
.cinfo a:hover{text-decoration:underline}
form.quote{display:grid;grid-template-columns:1fr 1fr;gap:1.8rem 1.6rem}
.fld{display:flex;flex-direction:column;gap:.4rem}
.fld.full{grid-column:1/-1}
.fld label{font-size:.88rem;color:var(--ink-2)}
.fld input,.fld select,.fld textarea{background:transparent;border:0;border-bottom:1px solid var(--ink);padding:.7rem 0;border-radius:0;outline-offset:2px;transition:border-color .3s}
.fld select{appearance:none;-webkit-appearance:none;background-image:linear-gradient(45deg,transparent 50%,currentColor 50%),linear-gradient(135deg,currentColor 50%,transparent 50%);background-position:calc(100% - 12px) 55%,calc(100% - 7px) 55%;background-size:5px 5px;background-repeat:no-repeat;cursor:pointer}
.fld select option{color:#3B2F24;background:#E8E2D9}
.fld textarea{min-height:130px;resize:vertical}
.fld input:focus,.fld select:focus,.fld textarea:focus{border-color:var(--umber)}
.fld .err{color:#8A3B2B;font-size:.82rem;min-height:1em}
:root[data-theme="dark"] .fld .err{color:#E8B9A5}
.actions{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:.8rem;align-items:center}
.status{grid-column:1/-1;min-height:1.4em;color:var(--ink-2);font-size:.95rem}
@media (max-width:900px){.contact{grid-template-columns:1fr}form.quote{grid-template-columns:1fr}}
.mapbox{margin-top:clamp(3rem,6vw,5rem);position:relative;height:420px;background:var(--bg-2);border:1px solid var(--line)}
.mapbox iframe{width:100%;height:100%;border:0;filter:var(--map);display:block}
.mapbox a{position:absolute;right:1rem;bottom:1rem;background:var(--bg);padding:.5rem .9rem;font-size:.88rem;border:1px solid var(--line)}

/* ---------- Footer ---------- */
footer{background:var(--bg-2);padding:clamp(3rem,6vw,5rem) 0 2rem;border-top:1px solid var(--line)}
.fgrid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:3rem}
.fgrid h4{font-family:var(--sans);font-size:.9rem;font-weight:600;margin-bottom:1rem}
.fgrid ul{list-style:none;margin:0;padding:0}
.fgrid li{padding:.25rem 0;color:var(--ink-2)}
.fgrid a:hover{text-decoration:underline}
.fbot{margin-top:3rem;padding-top:1.4rem;border-top:1px solid var(--line);font-size:.86rem;color:var(--ink-2)}
@media (max-width:760px){.fgrid{grid-template-columns:1fr;gap:2rem}}

/* ---------- WhatsApp butonu ---------- */
.wa-float{position:fixed;right:max(1rem,env(safe-area-inset-right,0px));bottom:calc(1rem + env(safe-area-inset-bottom,0px));z-index:45;display:flex;align-items:center;gap:.6rem;padding:.8rem 1.2rem .8rem 1rem;background:#3B2F24;color:#E8E2D9;border:1px solid rgba(232,226,217,.35);border-radius:999px;font-size:.92rem;font-weight:500;box-shadow:0 6px 22px rgba(36,28,21,.28);transition:background .3s,transform .3s}
.wa-float:hover{background:#8A7A68;transform:translateY(-2px)}
@media (max-width:600px){.wa-float{padding:.9rem}.wa-float span{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}}

/* ---------- Sayfa geçişi ---------- */
#app{outline:0}
#app.enter{animation:pagein .6s cubic-bezier(.2,.7,.2,1) both}
@keyframes pagein{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation:none!important;transition-duration:.01ms!important}
  .track{flex-wrap:wrap;width:auto}
}
